<!doctype html>
<html lang="id" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pengumuman Kelulusan - SMK Negeri 1 Kotamobagu</title>
  
  <!-- Scripts & Fonts -->
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-primary: #0f172a;
      --bg-secondary: #1e293b;
      --accent-blue: #0066ff;
      --accent-cyan: #0ea5e9;
      --accent-purple: #6366f1;
      --accent-green: #10b981;
      --accent-red: #ef4444;
      --text-primary: #f1f5f9;
      --text-secondary: #cbd5e1;
    }

    * { font-family: 'Plus Jakarta Sans', sans-serif; box-sizing: border-box; }
    .font-display { font-family: 'Space Grotesk', sans-serif; }

    body {
      background: linear-gradient(180deg, #0f172a 0%, #1a1f35 100%);
      color: var(--text-primary);
      overflow-x: hidden;
    }

    /* Animated gradient background */
    .animated-bg {
      background:
        radial-gradient(ellipse at top left, rgba(14, 165, 233, 0.12), transparent 50%),
        radial-gradient(ellipse at top right, rgba(168, 85, 247, 0.12), transparent 50%),
        radial-gradient(ellipse at bottom, rgba(34, 197, 94, 0.08), transparent 60%),
        linear-gradient(180deg, #0f172a 0%, #1a1f35 100%);
      position: relative;
    }

    /* Floating orbs */
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      opacity: 0.25;
      pointer-events: none;
      animation: float 8s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(30px, -30px) scale(1.1); }
    }

    .glass-card {
      background: rgba(30, 41, 59, 0.8);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 102, 255, 0.25);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .btn-gradient {
      background: linear-gradient(135deg, #0066ff 0%, #0099ff 100%);
      transition: all 0.3s ease;
      box-shadow: 0 4px 20px rgba(0, 102, 255, 0.4);
    }

    .btn-gradient:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(0, 102, 255, 0.5);
    }

    .btn-success {
      background: linear-gradient(135deg, #22c55e 0%, #10b981 100%);
      box-shadow: 0 4px 20px rgba(34, 197, 94, 0.4);
    }

    .input-modern {
      background: rgba(255, 255, 255, 0.05);
      border: 1.5px solid rgba(0, 102, 255, 0.25);
      color: white;
      transition: all 0.3s ease;
    }

    .input-modern:focus {
      outline: none;
      border-color: var(--accent-blue);
      background: rgba(255, 255, 255, 0.1);
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }

    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.9); }
      to { opacity: 1; transform: scale(1); }
    }
    .animate-scale-in { animation: scaleIn 0.5s ease-out forwards; }

    .spinner {
      border: 3px solid rgba(255,255,255,0.2);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .pulse-ring { animation: pulseRing 1.5s ease-out infinite; }
    @keyframes pulseRing {
      0% { transform: scale(0.8); opacity: 1; }
      100% { transform: scale(1.8); opacity: 0; }
    }

    .badge-pass {
      background: linear-gradient(135deg, rgba(34, 197, 94, 0.15), rgba(6, 182, 212, 0.15));
      border: 1px solid rgba(34, 197, 94, 0.4);
      color: #10b981;
    }

    .badge-fail {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(245, 101, 101, 0.15));
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #ef4444;
    }

    .confetti {
      position: absolute;
      width: 10px;
      height: 10px;
      animation: confetti-fall 3s linear forwards;
    }

    @keyframes confetti-fall {
      0% { transform: translateY(-100px) rotate(0deg); opacity: 1; }
      100% { transform: translateY(600px) rotate(720deg); opacity: 0; }
    }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-primary); }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
  </style>
</head>

<body class="h-full animated-bg">
  <!-- Background Orbs -->
  <div class="orb" style="width: 400px; height: 400px; background: #3b82f6; top: -100px; left: -100px;"></div>
  <div class="orb" style="width: 500px; height: 500px; background: #8b5cf6; top: 30%; right: -150px; animation-delay: 2s;"></div>
  <div class="orb" style="width: 350px; height: 350px; background: #06b6d4; bottom: -100px; left: 30%; animation-delay: 4s;"></div>

  <main class="relative w-full min-h-full flex flex-col">
    <!-- Header -->
    <header class="relative z-10 w-full px-4 sm:px-8 py-8">
      <div class="max-w-7xl mx-auto flex flex-col items-center justify-center text-center gap-4">
        <div id="logo-container">
          <img src="https://smkn1ktg.sch.id/logo/logo.gif" alt="Logo" class="h-20 sm:h-28 object-contain" loading="lazy">
        </div>
        <div>
          <h1 class="font-display font-bold text-lg sm:text-2xl leading-tight uppercase tracking-wide">SMK Negeri 1 Kotamobagu</h1>
          <p class="text-sm sm:text-base text-slate-300 font-semibold mt-2">Tahun Pelajaran 2025/2026</p>
        </div>
      </div>
      <div id="logout-btn-container" class="hidden absolute top-5 right-4 sm:right-8">
        <button id="logout-btn" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 transition-all text-sm">
          <i data-lucide="log-out" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Keluar</span>
        </button>
      </div>
    </header>

    <!-- Main Content Area -->
    <div class="flex-1 flex items-center justify-center px-4 py-8 relative z-10">
      
      <!-- LOADING STATE -->
      <div id="loading-screen" class="text-center animate-fade-in-up">
        <div class="relative inline-block mb-6">
          <div class="absolute inset-0 rounded-full bg-blue-500 pulse-ring"></div>
          <div class="relative w-16 h-16 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
            <div class="spinner w-8 h-8"></div>
          </div>
        </div>
        <p class="text-slate-300 font-medium">Memuat data siswa...</p>
      </div>

      <!-- ERROR STATE -->
      <div id="error-screen" class="hidden text-center max-w-md animate-fade-in-up">
        <div class="glass-card rounded-2xl p-8">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-red-500/20 border border-red-500/40 flex items-center justify-center">
            <i data-lucide="alert-triangle" class="w-8 h-8 text-red-400"></i>
          </div>
          <h2 class="font-display text-xl font-bold mb-2">Gagal Memuat Data</h2>
          <p class="text-slate-400 text-sm mb-5" id="error-message">Terjadi kesalahan. Silakan coba lagi.</p>
          <button onclick="loadStudentData()" class="btn-gradient px-6 py-2.5 rounded-lg font-semibold text-white">Coba Lagi</button>
        </div>
      </div>

      <!-- LOGIN SCREEN -->
      <div id="login-screen" class="hidden w-full max-w-md animate-fade-in-up">
        <div class="glass-card rounded-3xl p-6 sm:p-10">
          <div class="text-center mb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/30 border border-cyan-400/50 mb-4">
              <span class="w-2 h-2 rounded-full bg-cyan-300 animate-pulse"></span>
              <span class="text-xs font-semibold text-cyan-200 uppercase">Pengumuman Resmi</span>
            </div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold mb-2 bg-gradient-to-r from-cyan-300 via-blue-300 to-blue-400 bg-clip-text text-transparent">Cek Kelulusan</h2>
            <p class="text-cyan-100 text-sm">Masukkan NISN 10 digit Anda</p>
          </div>
          <form id="login-form" class="space-y-5">
            <div>
              <label for="nisn-input" class="block text-sm font-semibold text-slate-200 mb-2">NISN Siswa</label>
              <input type="text" id="nisn-input" inputmode="numeric" maxlength="10" placeholder="Contoh: 0012345678" class="w-full px-4 py-3.5 rounded-xl input-modern tracking-widest font-display text-lg" required>
              <p id="login-error" class="hidden mt-2 text-sm text-red-400 items-center gap-1.5">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
                <span id="login-error-text"></span>
              </p>
            </div>
            <button type="submit" id="login-submit" class="btn-gradient w-full py-3.5 rounded-xl font-bold text-white flex items-center justify-center gap-2">
              <span id="login-btn-text">Periksa Sekarang</span>
              <i data-lucide="arrow-right" class="w-5 h-5" id="login-btn-icon"></i>
            </button>
          </form>
          <div class="mt-6 pt-6 border-t border-white/5 text-center">
            <p id="total-students-label" class="text-xs text-slate-500">Total data terverifikasi: <span id="total-students">-</span></p>
          </div>
        </div>
      </div>

      <!-- RESULT SCREEN -->
      <div id="result-screen" class="hidden w-full max-w-2xl animate-scale-in">
        <div id="result-content" class="glass-card rounded-3xl overflow-hidden">
          <!-- Content injected by JS -->
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="relative z-10 w-full px-4 py-5 text-center text-xs text-slate-500">
      <p>© 2026 SMK Negeri 1 Kotamobagu. All Rights Reserved.</p>
    </footer>
  </main>

  <div id="confetti-container" class="fixed inset-0 pointer-events-none z-50"></div>

  <script>
    const SHEET_ID = '2PACX-1vQ7dKWe0slwGrGr6Q58QYTP1Plyh9_pv9jbPnh1Xo44mXmJfsHyQfQtPoKo50c1yw';
    const SHEET_URL = `https://docs.google.com/spreadsheets/d/e/${SHEET_ID}/pub?output=csv`;

    let studentsData = [];
    let currentStudent = null;

    const loadingScreen = document.getElementById('loading-screen');
    const errorScreen = document.getElementById('error-screen');
    const loginScreen = document.getElementById('login-screen');
    const resultScreen = document.getElementById('result-screen');
    const logoutBtnContainer = document.getElementById('logout-btn-container');

    lucide.createIcons();

    // CSV Parser
    function parseCSV(text) {
      const rows = [];
      let current = [];
      let field = '';
      let inQuotes = false;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (inQuotes) {
          if (ch === '"' && text[i+1] === '"') { field += '"'; i++; }
          else if (ch === '"') inQuotes = false;
          else field += ch;
        } else {
          if (ch === '"') inQuotes = true;
          else if (ch === ',') { current.push(field); field = ''; }
          else if (ch === '\n' || ch === '\r') {
            if (ch === '\r' && text[i+1] === '\n') i++;
            current.push(field); rows.push(current);
            current = []; field = '';
          } else field += ch;
        }
      }
      if (field || current.length) { current.push(field); rows.push(current); }
      return rows;
    }

    async function loadStudentData() {
      showScreen('loading');
      try {
        const response = await fetch(SHEET_URL);
        if (!response.ok) throw new Error('Fetch failed');
        const csvText = await response.text();
        const rows = parseCSV(csvText).filter(r => r.length > 1);
        
        // Map data (Sesuaikan indeks kolom jika berbeda)
        studentsData = rows.slice(1).map(row => ({
          nisn: (row[2] || '').trim(),
          nama: (row[3] || '').trim(),
          konsentrasi: (row[8] || '').trim(),
          status: (row[9] || '').trim(),
          skl: (row[10] || '').trim()
        })).filter(s => s.nisn);

        document.getElementById('total-students').textContent = studentsData.length;
        showScreen('login');
      } catch (err) {
        document.getElementById('error-message').textContent = 'Gagal mengambil data dari server.';
        showScreen('error');
      }
    }

    function showScreen(name) {
      [loadingScreen, errorScreen, loginScreen, resultScreen, logoutBtnContainer].forEach(el => el.classList.add('hidden'));
      if (name === 'loading') loadingScreen.classList.remove('hidden');
      else if (name === 'error') errorScreen.classList.remove('hidden');
      else if (name === 'login') loginScreen.classList.remove('hidden');
      else if (name === 'result') { resultScreen.classList.remove('hidden'); logoutBtnContainer.classList.remove('hidden'); }
      lucide.createIcons();
    }

    document.getElementById('login-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const nisn = document.getElementById('nisn-input').value.trim();
      const student = studentsData.find(s => s.nisn === nisn);

      if (!student) {
        const err = document.getElementById('login-error');
        document.getElementById('login-error-text').textContent = "NISN tidak ditemukan!";
        err.classList.remove('hidden');
        err.classList.add('flex');
        return;
      }

      currentStudent = student;
      startCountdown();
    });

    function startCountdown() {
      const overlay = document.createElement('div');
      overlay.style.cssText = `position:fixed;inset:0;background:rgba(15,23,42,0.95);display:flex;align-items:center;justify-content:center;z-index:9999;`;
      overlay.innerHTML = `<div id="cd-num" style="font-size:150px;font-weight:900;font-family:'Space Grotesk';color:#3b82f6;animation:scaleIn 0.5s infinite;">3</div>`;
      document.body.appendChild(overlay);

      let count = 3;
      const timer = setInterval(() => {
        count--;
        if (count > 0) {
          document.getElementById('cd-num').textContent = count;
        } else {
          clearInterval(timer);
          overlay.remove();
          displayResult(currentStudent);
        }
      }, 1000);
    }

    function displayResult(s) {
      const isPassed = /lulus/i.test(s.status) && !/tidak/i.test(s.status);
      const resultContent = document.getElementById('result-content');
      
      resultContent.innerHTML = `
        <div class="relative p-8 text-center ${isPassed ? 'bg-green-500/5' : 'bg-red-500/5'}">
          <div class="w-20 h-20 mx-auto rounded-full ${isPassed ? 'bg-green-500' : 'bg-red-500'} flex items-center justify-center mb-6">
            <i data-lucide="${isPassed ? 'check' : 'x'}" class="w-12 h-12 text-white"></i>
          </div>
          <h2 class="text-4xl font-display font-black mb-2 ${isPassed ? 'text-green-400' : 'text-red-400'}">
            ${isPassed ? 'LULUS' : 'BELUM LULUS'}
          </h2>
          <p class="text-slate-400 uppercase tracking-widest text-sm font-bold">Status Kelulusan</p>
        </div>
        <div class="p-8 space-y-4 border-t border-white/5">
          <div class="grid grid-cols-1 gap-4 text-left">
            <div class="bg-white/5 p-4 rounded-xl">
              <p class="text-xs text-slate-500 font-bold uppercase">Nama Siswa</p>
              <p class="text-lg font-semibold">${s.nama}</p>
            </div>
            <div class="bg-white/5 p-4 rounded-xl">
              <p class="text-xs text-slate-500 font-bold uppercase">NISN</p>
              <p class="text-lg font-mono">${s.nisn}</p>
            </div>
            <div class="bg-white/5 p-4 rounded-xl">
              <p class="text-xs text-slate-500 font-bold uppercase">Jurusan</p>
              <p class="text-lg font-semibold">${s.konsentrasi}</p>
            </div>
          </div>
          ${isPassed && s.skl ? `
            <a href="${s.skl}" target="_blank" class="btn-success w-full py-4 rounded-xl font-bold text-white flex items-center justify-center gap-2 mt-4 transition-transform hover:scale-[1.02]">
              <i data-lucide="download" class="w-5 h-5"></i> Download SKL Digital
            </a>
          ` : ''}
        </div>
      `;
      
      showScreen('result');
      if (isPassed) launchConfetti();
    }

    function launchConfetti() {
      const container = document.getElementById('confetti-container');
      const colors = ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'];
      for (let i = 0; i < 50; i++) {
        const c = document.createElement('div');
        c.className = 'confetti';
        c.style.left = Math.random() * 100 + '%';
        c.style.background = colors[Math.floor(Math.random() * colors.length)];
        c.style.animationDuration = (2 + Math.random() * 2) + 's';
        container.appendChild(c);
      }
      setTimeout(() => container.innerHTML = '', 4000);
    }

    document.getElementById('logout-btn').addEventListener('click', () => {
      document.getElementById('nisn-input').value = '';
      showScreen('login');
    });

    loadStudentData();
  </script>
</body>
</html>
