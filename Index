<!doctype html>
<html lang="id" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pengumuman Kelulusan - SMK Negeri 1 Kotamobagu</title>
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #0f172a;
            --accent-blue: #0066ff;
            --text-primary: #f1f5f9;
        }

        body {
            background: linear-gradient(180deg, #0f172a 0%, #1a1f35 100%);
            color: var(--text-primary);
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }

        .font-display { font-family: 'Space Grotesk', sans-serif; }

        .animated-bg {
            background: 
                radial-gradient(ellipse at top left, rgba(14, 165, 233, 0.15), transparent 50%),
                radial-gradient(ellipse at top right, rgba(168, 85, 247, 0.15), transparent 50%),
                linear-gradient(180deg, #0f172a 0%, #1a1f35 100%);
            position: relative;
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .btn-gradient {
            background: linear-gradient(135deg, #0066ff 0%, #0099ff 100%);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-gradient:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(0, 102, 255, 0.5);
        }

        .spinner {
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-up { animation: fadeInUp 0.6s ease-out forwards; }
        
        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            z-index: 100;
            animation: fall 3s linear forwards;
        }

        @keyframes fall {
            to { transform: translateY(100vh) rotate(720deg); opacity: 0; }
        }
    </style>
</head>
<body class="h-full animated-bg">

<main class="relative z-10 min-h-full flex flex-col">
    <!-- Header -->
    <header class="w-full px-6 py-10 text-center">
        <img src="https://smkn1ktg.sch.id/logo/logo.gif" alt="Logo" class="h-24 mx-auto mb-6 drop-shadow-2xl">
        <h1 class="font-display font-bold text-2xl sm:text-3xl uppercase tracking-tighter">SMK Negeri 1 Kotamobagu</h1>
        <p class="text-slate-400 mt-2 font-medium">Sistem Informasi Kelulusan TA 2025/2026</p>
    </header>

    <div class="flex-1 flex items-center justify-center px-4 pb-20">
        <!-- Loading -->
        <div id="loading-screen" class="text-center">
            <div class="spinner w-12 h-12 mx-auto mb-4"></div>
            <p class="text-slate-400 animate-pulse">Sinkronisasi data siswa...</p>
        </div>

        <!-- Login Card -->
        <div id="login-screen" class="hidden w-full max-w-md animate-fade-up">
            <div class="glass-card rounded-3xl p-8 sm:p-10">
                <div class="mb-8 text-center">
                    <span class="bg-blue-500/20 text-blue-400 text-xs font-bold px-3 py-1 rounded-full border border-blue-500/30">PORTAL RESMI</span>
                    <h2 class="text-2xl font-bold mt-4">Cek Status Anda</h2>
                </div>

                <form id="login-form" class="space-y-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-300 mb-2">NISN Siswa</label>
                        <input type="text" id="nisn-input" maxlength="10" placeholder="Masukkan 10 digit NISN" 
                            class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none focus:border-blue-500 transition-all font-mono tracking-widest text-lg" required>
                        <p id="error-msg" class="hidden text-red-400 text-xs mt-2 flex items-center gap-1">
                            <i data-lucide="alert-circle" class="w-3 h-3"></i> NISN tidak ditemukan!
                        </p>
                    </div>
                    <button type="submit" id="btn-submit" class="btn-gradient w-full py-4 rounded-2xl font-bold flex items-center justify-center gap-2">
                        <span>Lihat Hasil</span>
                        <i data-lucide="chevron-right" class="w-5 h-5"></i>
                    </button>
                </form>
            </div>
        </div>

        <!-- Result View -->
        <div id="result-screen" class="hidden w-full max-w-2xl animate-fade-up">
            <div id="result-container" class="glass-card rounded-3xl overflow-hidden">
                <!-- Data injected by JS -->
            </div>
            <button onclick="location.reload()" class="mt-6 mx-auto flex items-center gap-2 text-slate-400 hover:text-white transition-colors">
                <i data-lucide="refresh-ccw" class="w-4 h-4"></i> Kembali ke Pencarian
            </button>
        </div>
    </div>

    <footer class="py-6 text-center text-slate-500 text-sm border-t border-white/5">
        &copy; 2026 IT Center SMK Negeri 1 Kotamobagu
    </footer>
</main>

<script>
    const SHEET_ID = '2PACX-1vQ7dKWe0slwGrGr6Q58QYTP1Plyh9_pv9jbPnh1Xo44mXmJfsHyQfQtPoKo50c1yw';
    const CSV_URL = `https://docs.google.com/spreadsheets/d/e/${SHEET_ID}/pub?output=csv`;
    
    let students = [];

    // Initialize Icons
    lucide.createIcons();

    // Fetch Data
    async function init() {
        try {
            const response = await fetch(CSV_URL);
            const data = await response.text();
            parseData(data);
            document.getElementById('loading-screen').classList.add('hidden');
            document.getElementById('login-screen').classList.remove('hidden');
        } catch (err) {
            alert('Gagal memuat database siswa. Periksa koneksi internet.');
        }
    }

    function parseData(csv) {
        const lines = csv.split('\n').slice(1);
        students = lines.map(line => {
            const cols = line.split(',').map(c => c.trim().replace(/^"|"$/g, ''));
            return {
                nisn: cols[2],         // Kolom C
                nama: cols[3],         // Kolom D
                jurusan: cols[8],      // Kolom I
                status: cols[9],       // Kolom J
                skl: cols[10]          // Kolom K
            };
        });
    }

    // Form Action
    document.getElementById('login-form').onsubmit = (e) => {
        e.preventDefault();
        const input = document.getElementById('nisn-input').value;
        const student = students.find(s => s.nisn === input);

        if (student) {
            showResult(student);
        } else {
            document.getElementById('error-msg').classList.remove('hidden');
        }
    };

    function showResult(s) {
        const isLulus = s.status.toLowerCase() === 'lulus';
        const container = document.getElementById('result-container');
        
        document.getElementById('login-screen').classList.add('hidden');
        document.getElementById('result-screen').classList.remove('hidden');

        container.innerHTML = `
            <div class="p-10 text-center ${isLulus ? 'bg-emerald-500/10' : 'bg-red-500/10'}">
                <div class="w-20 h-20 mx-auto rounded-full flex items-center justify-center mb-6 ${isLulus ? 'bg-emerald-500 text-white' : 'bg-red-500 text-white'}">
                    <i data-lucide="${isLulus ? 'award' : 'x-circle'}" class="w-12 h-12"></i>
                </div>
                <h3 class="text-slate-400 font-medium uppercase tracking-widest text-sm">Status Kelulusan</h3>
                <h2 class="text-5xl font-black mt-2 ${isLulus ? 'text-emerald-400' : 'text-red-400'}">${s.status.toUpperCase()}</h2>
            </div>
            
            <div class="p-8 space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="bg-white/5 p-4 rounded-2xl">
                        <p class="text-xs text-slate-500 mb-1">Nama Lengkap</p>
                        <p class="font-bold text-white">${s.nama}</p>
                    </div>
                    <div class="bg-white/5 p-4 rounded-2xl">
                        <p class="text-xs text-slate-500 mb-1">NISN</p>
                        <p class="font-mono text-white">${s.nisn}</p>
                    </div>
                </div>
                <div class="bg-white/5 p-4 rounded-2xl">
                    <p class="text-xs text-slate-500 mb-1">Konsentrasi Keahlian</p>
                    <p class="font-bold text-white">${s.jurusan}</p>
                </div>

                ${isLulus && s.skl ? `
                    <a href="${s.skl}" target="_blank" class="block w-full bg-emerald-600 hover:bg-emerald-500 text-white text-center py-4 rounded-2xl font-bold transition-all flex items-center justify-center gap-2 mt-6">
                        <i data-lucide="download" class="w-5 h-5"></i> Unduh SKL (PDF)
                    </a>
                ` : ''}
            </div>
        `;
        
        if(isLulus) createConfetti();
        lucide.createIcons();
    }

    function createConfetti() {
        for(let i=0; i<50; i++) {
            const c = document.createElement('div');
            c.className = 'confetti';
            c.style.left = Math.random() * 100 + 'vw';
            c.style.backgroundColor = ['#10b981', '#3b82f6', '#f59e0b'][Math.floor(Math.random()*3)];
            c.style.animationDelay = Math.random() * 2 + 's';
            document.body.appendChild(c);
        }
    }

    init();
</script>
</body>
</html>
