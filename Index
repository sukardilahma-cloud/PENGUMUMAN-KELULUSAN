<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Kelulusan - SMK Negeri 1 Kotamobagu</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #0f172a;
            --accent: #3b82f6;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--primary);
            color: #f1f5f9;
            overflow-x: hidden;
        }
        .font-display { font-family: 'Space Grotesk', sans-serif; }
        
        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .orb {
            position: fixed;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.15;
            z-index: -1;
            animation: float 10s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(30px, 40px); }
        }

        .spinner {
            border: 3px solid rgba(255,255,255,0.1);
            border-top-color: #3b82f6;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            z-index: 100;
            animation: fall 3s linear forwards;
        }
        @keyframes fall {
            to { transform: translateY(100vh) rotate(720deg); opacity: 0; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Orbs Background -->
    <div class="orb bg-blue-600 top-[-100px] left-[-100px]"></div>
    <div class="orb bg-purple-600 bottom-[-100px] right-[-100px]" style="animation-delay: -5s;"></div>

    <!-- Main Container -->
    <div class="flex-grow flex flex-col items-center justify-center p-6">
        
        <!-- Header -->
        <header class="text-center mb-10">
            <img src="https://smkn1ktg.sch.id/logo/logo.gif" alt="Logo SMK" class="h-24 mx-auto mb-4 drop-shadow-2xl">
            <h1 class="font-display text-2xl md:text-3xl font-bold tracking-tight">SMK NEGERI 1 KOTAMOBAGU</h1>
            <p class="text-slate-400 mt-2 font-medium">Pengumuman Kelulusan TP. 2025/2026</p>
        </header>

        <!-- Card Section -->
        <div class="w-full max-w-md">
            
            <!-- Loading State -->
            <div id="loading" class="glass-card rounded-3xl p-8 text-center">
                <div class="spinner mx-auto mb-4"></div>
                <p class="text-sm text-slate-300">Menghubungkan ke server data...</p>
            </div>

            <!-- Login View -->
            <div id="view-login" class="hidden glass-card rounded-3xl p-8 shadow-2xl">
                <h2 class="text-xl font-bold mb-6 text-center">Masukkan NISN</h2>
                <form id="form-login" class="space-y-4">
                    <div>
                        <input type="text" id="input-nisn" maxlength="10" placeholder="Contoh: 0071234567" 
                            class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-lg font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all text-center">
                        <p id="error-msg" class="text-red-400 text-xs mt-2 hidden text-center"></p>
                    </div>
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition-all flex items-center justify-center gap-2">
                        <i data-lucide="search" class="w-5 h-5"></i> Periksa Data
                    </button>
                </form>
            </div>

            <!-- Result View -->
            <div id="view-result" class="hidden glass-card rounded-3xl overflow-hidden shadow-2xl animate-in zoom-in duration-300">
                <div id="status-header" class="p-8 text-center">
                    <!-- Icon & Status injected here -->
                </div>
                <div class="p-6 bg-slate-900/50 space-y-4">
                    <div class="flex flex-col border-b border-slate-800 pb-2">
                        <span class="text-[10px] uppercase tracking-wider text-slate-500 font-bold">Nama Lengkap</span>
                        <span id="res-nama" class="font-bold text-lg"></span>
                    </div>
                    <div class="flex flex-col border-b border-slate-800 pb-2">
                        <span class="text-[10px] uppercase tracking-wider text-slate-500 font-bold">Jurusan</span>
                        <span id="res-jurusan" class="font-semibold"></span>
                    </div>
                    
                    <div id="btn-container" class="pt-4 space-y-3">
                        <!-- SKL Button injected here -->
                    </div>

                    <button onclick="resetView()" class="w-full text-slate-400 text-sm py-2 hover:text-white transition-colors">
                        Kembali
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="p-6 text-center text-slate-600 text-xs">
        &copy; 2026 SMK Negeri 1 Kotamobagu • Tim IT Multimedia
    </footer>

    <script>
        // --- KONFIGURASI ---
        const SHEET_ID = '2PACX-1vQ7dKWe0slwGrGr6Q58QYTP1Plyh9_pv9jbPnh1Xo44mXmJfsHyQfQtPoKo50c1yw';
        const CSV_URL = `https://docs.google.com/spreadsheets/d/e/${SHEET_ID}/pub?output=csv`;

        let database = [];

        // Initialize Icons
        lucide.createIcons();

        // Fetch Data
        async function init() {
            try {
                const response = await fetch(CSV_URL);
                const data = await response.text();
                database = parseCSV(data);
                
                document.getElementById('loading').classList.add('hidden');
                document.getElementById('view-login').classList.remove('hidden');
            } catch (error) {
                document.getElementById('loading').innerHTML = `
                    <div class="text-red-400 p-4">
                        <i data-lucide="wifi-off" class="mx-auto mb-2"></i>
                        Gagal memuat data. Periksa koneksi internet Anda.
                    </div>
                `;
                lucide.createIcons();
            }
        }

        function parseCSV(str) {
            const arr = [];
            let quote = false;
            let row = [""], col = 0;

            for (let c = 0; c < str.length; c++) {
                let cc = str[c], nc = str[c+1];
                if (cc == '"' && quote && nc == '"') { row[col] += cc; ++c; continue; }
                if (cc == '"') { quote = !quote; continue; }
                if (cc == ',' && !quote) { row[++col] = ""; continue; }
                if (cc == '\r' && nc == '\n' && !quote) { arr.push(row); row = [""]; col = 0; ++c; continue; }
                if (cc == '\n' && !quote) { arr.push(row); row = [""]; col = 0; continue; }
                if (cc == '\r' && !quote) { arr.push(row); row = [""]; col = 0; continue; }
                row[col] += cc;
            }
            if (row[0] !== "") arr.push(row);
            return arr;
        }

        // Logic Periksa
        document.getElementById('form-login').addEventListener('submit', function(e) {
            e.preventDefault();
            const input = document.getElementById('input-nisn').value.trim();
            const errorElement = document.getElementById('error-msg');
            
            errorElement.classList.add('hidden');

            // Cari data di kolom C (index 2)
            const student = database.find(r => r[2] === input);

            if (student) {
                showResult(student);
            } else {
                errorElement.innerText = "NISN tidak ditemukan. Pastikan angka sudah benar.";
                errorElement.classList.remove('hidden');
            }
        });

        function showResult(data) {
            const status = data[9] ? data[9].toUpperCase() : ""; // Kolom J
            const isLulus = status.includes("LULUS") && !status.includes("TIDAK");
            
            document.getElementById('res-nama').innerText = data[3]; // Kolom D
            document.getElementById('res-jurusan').innerText = data[8]; // Kolom I
            
            const header = document.getElementById('status-header');
            const btnContainer = document.getElementById('btn-container');

            if (isLulus) {
                header.className = "p-8 text-center bg-green-500/20 text-green-400";
                header.innerHTML = `
                    <div class="w-16 h-16 bg-green-500 text-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-green-500/40">
                        <i data-lucide="party-popper" class="w-8 h-8"></i>
                    </div>
                    <h2 class="text-3xl font-display font-bold">LULUS</h2>
                `;
                
                // Cek link SKL di kolom K (index 10)
                if (data[10] && data[10].startsWith('http')) {
                    btnContainer.innerHTML = `
                        <a href="${data[10]}" target="_blank" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-xl transition-all flex items-center justify-center gap-2 shadow-lg shadow-green-600/20">
                            <i data-lucide="download" class="w-5 h-5"></i> Unduh SKL Digital
                        </a>
                    `;
                }
                createConfetti();
            } else {
                header.className = "p-8 text-center bg-red-500/20 text-red-400";
                header.innerHTML = `
                    <div class="w-16 h-16 bg-red-500 text-white rounded-full flex items-center justify-center mx-auto mb-4">
                        <i data-lucide="info" class="w-8 h-8"></i>
                    </div>
                    <h2 class="text-3xl font-display font-bold">BELUM LULUS</h2>
                `;
                btnContainer.innerHTML = `<p class="text-center text-xs text-slate-400 italic">Silakan hubungi Wali Kelas untuk informasi lebih lanjut.</p>`;
            }

            document.getElementById('view-login').classList.add('hidden');
            document.getElementById('view-result').classList.remove('hidden');
            lucide.createIcons();
        }

        function createConfetti() {
            for(let i=0; i<50; i++) {
                const conf = document.createElement('div');
                conf.className = 'confetti';
                conf.style.left = Math.random() * 100 + 'vw';
                conf.style.backgroundColor = ['#3b82f6', '#22c55e', '#eab308', '#ec4899'][Math.floor(Math.random()*4)];
                conf.style.transform = `rotate(${Math.random() * 360}deg)`;
                conf.style.animationDelay = Math.random() * 2 + 's';
                document.body.appendChild(conf);
                setTimeout(() => conf.remove(), 4000);
            }
        }

        function resetView() {
            document.getElementById('view-result').classList.add('hidden');
            document.getElementById('view-login').classList.remove('hidden');
            document.getElementById('input-nisn').value = "";
        }

        init();
    </script>
</body>
</html>
